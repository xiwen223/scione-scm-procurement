<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.scione.scm.bill.infrastructure.persistence.mybatis.mapper.ProcurementOperationLogMapper">

    <sql id="columns">
        id,
        business_type,
        data_id,
        data_name,
        operator_id,
        operator_name,
        operation_type,
        operation_desc,
        operation_details,
        ip_address,
        create_time
    </sql>

    <sql id="filters">
        <if test="dataName != null and dataName != ''">
            AND data_name LIKE CONCAT('%', #{dataName}, '%')
        </if>
        <if test="businessType != null">
            AND business_type = #{businessType}
        </if>
        <if test="operationType != null and operationType != ''">
            AND operation_type LIKE CONCAT('%', #{operationType}, '%')
        </if>
        <if test="operator != null and operator != ''">
            AND (
                operator_name LIKE CONCAT('%', #{operator}, '%')
                OR CAST(operator_id AS CHAR) LIKE CONCAT('%', #{operator}, '%')
            )
        </if>
        <if test="startTime != null">
            AND create_time <![CDATA[>=]]> #{startTime}
        </if>
        <if test="endTime != null">
            AND create_time <![CDATA[<]]> #{endTime}
        </if>
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO procurement_operation_log (
            business_type,
            data_id,
            data_name,
            operator_id,
            operator_name,
            operation_type,
            operation_desc,
            operation_details,
            ip_address
        ) VALUES (
            #{businessType},
            #{dataId},
            #{dataName},
            #{operatorId},
            #{operatorName},
            #{operationType},
            #{operationDesc},
            #{operationDetails},
            #{ipAddress}
        )
    </insert>

    <select id="count" resultType="long">
        SELECT COUNT(1)
        FROM procurement_operation_log
        WHERE 1 = 1
        <include refid="filters"/>
    </select>

    <select id="findPage" resultType="com.scione.scm.bill.infrastructure.persistence.mybatis.po.ProcurementOperationLogPO">
        SELECT
            <include refid="columns"/>
        FROM procurement_operation_log
        WHERE 1 = 1
        <include refid="filters"/>
        ORDER BY create_time DESC, id DESC
        LIMIT #{pageSize} OFFSET #{offset}
    </select>
</mapper>
